# ---- API server ----
NODE_ENV=production
PORT=3000

# The GHCR image path the deploy workflow pushes to — only needed on the
# actual server (not for local dev, which builds from source instead).
# Matches ghcr.io/<your-github-username-or-org>/<repo-name>/api:latest
API_IMAGE=ghcr.io/yourusername/backup-buddies/api:latest

# Postgres (the api and postgres containers talk over the compose network;
# "postgres" below is the service name, not a placeholder to rename)
# POSTGRES_PASSWORD is also read directly by docker-compose.yml to set up
# the database — keep it identical to the password in DATABASE_URL below.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://backup_buddies:CHANGE_ME@postgres:5432/backup_buddies

# ---- Stripe ----
# Secret key from the Stripe dashboard (use a restricted key with only the
# scopes this app needs: customers, subscriptions, billing meters, webhooks)
# Use the sk_test_... key until you're ready to take real payments.
STRIPE_SECRET_KEY=sk_live_or_test_xxx

# Webhook signing secret for the /webhooks/stripe endpoint
# (Dashboard > Developers > Webhooks > your endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# The tiered storage Price (first 50GB/account free, then $3/TB/month,
# quantity = GB pledged across active buddy pairings). Created by
# scripts/create-stripe-storage-price.mjs — see docs/DEPLOY.md.
STRIPE_STORAGE_PRICE_ID=price_xxx

# The metered Price ID used for relay-bandwidth overage billing (not wired
# up yet — reserved for when relay_usage_events actually gets reported to
# Stripe on a schedule)
STRIPE_RELAY_METER_ID=mtr_xxx

# Used to build Checkout/Billing Portal redirect URLs — no trailing slash
APP_URL=https://app.filegarden.net

# ---- Google sign-in ----
# From the Google Cloud Console: APIs & Services > Credentials > your OAuth
# 2.0 Client ID (type "Web application"). Authorized redirect URI must be
# exactly GOOGLE_REDIRECT_URI below. Leaving these unset just disables the
# "Continue with Google" button — email/password still works.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=https://app.filegarden.net/api/auth/google/callback

# ---- Relay ----
# Public hostname of the Iroh relay (DNS-only / grey-cloud record)
RELAY_HOSTNAME=relay.filegarden.net
