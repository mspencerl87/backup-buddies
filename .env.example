# ---- API server ----
NODE_ENV=production
PORT=3000

# The GHCR image path the deploy workflow pushes to — only needed on the
# actual server (not for local dev, which builds from source instead).
# Matches ghcr.io/<your-github-username-or-org>/<repo-name>/api:latest
API_IMAGE=ghcr.io/yourusername/backup-buddies/api:latest

# Postgres (the api and postgres containers talk over the compose network;
# "postgres" below is the service name, not a placeholder to rename)
# POSTGRES_PASSWORD is also read directly by docker-compose.yml to set up
# the database — keep it identical to the password in DATABASE_URL below.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://backup_buddies:CHANGE_ME@postgres:5432/backup_buddies

# ---- Stripe ----
# Secret key from the Stripe dashboard (use a restricted key with only the
# scopes this app needs: customers, subscriptions, billing meters, webhooks)
# Use the sk_test_... key until you're ready to take real payments.
STRIPE_SECRET_KEY=sk_live_or_test_xxx

# Webhook signing secret for the /webhooks/stripe endpoint
# (Dashboard > Developers > Webhooks > your endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# The paid plan's flat Price ($3/month, quantity 1, any pledge size; the
# first 50GB pledged needs no subscription). Named STORAGE from when it was
# a per-TB storage price. Created by scripts/create-stripe-storage-price.mjs
# — see docs/DEPLOY.md.
STRIPE_STORAGE_PRICE_ID=price_xxx

# Relay-bandwidth billing ($0.02/GB past the monthly allowance, paid
# accounts only — bundled as a second line item onto the same subscription
# as the plan above). Created by
# scripts/create-stripe-relay-meter-and-price.mjs. STRIPE_RELAY_PRICE_ID is
# the one that actually matters to the running app — it's what gets added
# to checkout (routes/billing.js) and gates the periodic Stripe-sync job
# (index.js). STRIPE_RELAY_METER_ID isn't read by any code; it's kept here
# just for reference since usage is reported to Stripe by event name, not
# meter id (see apps/api/src/lib/relay-billing.js). If there are existing
# paying accounts when you first set this up, also run
# scripts/add-relay-price-to-existing-subscriptions.mjs once.
STRIPE_RELAY_PRICE_ID=price_xxx
STRIPE_RELAY_METER_ID=mtr_xxx

# Used to build Checkout/Billing Portal redirect URLs — no trailing slash
APP_URL=https://app.filegarden.net

# ---- Google sign-in ----
# From the Google Cloud Console: APIs & Services > Credentials > your OAuth
# 2.0 Client ID (type "Web application"). Authorized redirect URI must be
# exactly GOOGLE_REDIRECT_URI below. Leaving these unset just disables the
# "Continue with Google" button — email/password still works.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=https://app.filegarden.net/api/auth/google/callback

# ---- Admin ----
# Comma-separated list of account emails allowed to use /admin.html and the
# /admin/* API routes (view every account, delete devices/pairings/invites,
# delete an account outright). Case-insensitive. Leave unset/empty and
# those routes 403 for everyone, including you.
ADMIN_EMAILS=mspencerl87@gmail.com

# ---- Relay ----
# Public hostname of the Iroh relay (DNS-only / grey-cloud record)
RELAY_HOSTNAME=relay.filegarden.net

# ---- Outgoing email (verification links, stale-account notices) ----
# Plain SMTP against an existing mailbox — no separate transactional-email
# provider needed. Tested against Purelymail (smtp.purelymail.com, port 465
# with implicit TLS, or 587 with STARTTLS); any standard SMTP mailbox works
# the same way. Leave these unset and the API just logs what it would have
# sent instead of erroring — fine for local dev, not for production.
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=CHANGE_ME
# Optional — defaults to SMTP_USER. A display name makes verification
# emails look less like spam.
MAIL_FROM="Backup Buddies <you@yourdomain.com>"

# ---- Stale-account lifecycle ----
# Off by default. When true: an account with no device activity (see
# devices.last_seen_at) in 30 days gets a warning email, and any account
# still inactive 30 days after THAT gets listed in a monthly digest emailed
# to ADMIN_EMAILS for manual review — nothing is ever deleted
# automatically; that stays a deliberate action from /admin.html. See
# docs/DEPLOY.md section 15.
STALE_ACCOUNT_CLEANUP_ENABLED=false

# Comma-separated emails to exclude from the above entirely (e.g. accounts
# you keep around on purpose for troubleshooting). ADMIN_EMAILS accounts
# are always excluded too.
STALE_CLEANUP_EXEMPT_EMAILS=testa@example.com,testb@example.com

# ---- Relay access ----
# Shared secret relay-1 sends when it asks this API whether a connecting
# device may use the relay (POST /relay/access, routes/relay.js). Must be
# the same value as RELAY_ACCESS_TOKEN in deploy/relay/.env on relay-1.
# Generate with: openssl rand -hex 32
RELAY_ACCESS_TOKEN=

# Monthly relay allowance for free (unsubscribed) accounts, in GB. Past it,
# the account's buddy syncing pauses until the 1st or until it subscribes.
# Direct/LAN traffic never counts. See lib/relay-billing.js.
FREE_RELAY_GB_PER_MONTH=10

# ---- Off-site database backup (deploy/app/backup-db.sh) ----
# Nightly pg_dump to Backblaze B2. Use an application key restricted to this
# one bucket with only listBuckets, listFiles and writeFiles, so nothing on
# this server can delete old backups (B2's lifecycle rule does that). See
# docs/DEPLOY.md section 26.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Optional: an Uptime Kuma "Push" monitor URL, pinged after each upload.
BACKUP_PING_URL=
