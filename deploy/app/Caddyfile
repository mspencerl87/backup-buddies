# Replace with your real API hostname. Caddy will automatically obtain and
# renew a TLS certificate via Let's Encrypt — this works whether or not the
# DNS record is proxied through Cloudflare, as long as port 80 is reachable
# for the ACME challenge.
api.filegarden.net {
	reverse_proxy api:3000
}

app.filegarden.net {
	# Everything under /api/* goes to the backend, prefix stripped so the
	# Express routes stay unprefixed (e.g. /api/signup -> POST /signup).
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# The backup client's source + install files, served publicly so
	# customers can fetch it with one curl command even though this repo
	# itself is private — see apps/client/install.sh.
	handle_path /client/* {
		root * /srv/client
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else is the static site. no-cache (not no-store) means
	# browsers always revalidate with a conditional request before reusing
	# a cached copy — still fast (a 304 when nothing changed), but a push
	# here is never masked by a stale local copy sitting around.
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		file_server
	}
}
