[Unit]
Description=Back up the Backup Buddies database to Backblaze B2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# @CHECKOUT@ is filled in with the repo's path on the server at install time
# (docs/DEPLOY.md section 26).
ExecStart=@CHECKOUT@/deploy/app/backup-db.sh
