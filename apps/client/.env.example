# Backup Buddies control-plane API. Leave this as-is unless you're running
# against a self-hosted instance of the service.
API_URL=https://api.filegarden.net

# From your dashboard's Devices card → "Add device". Shown once at
# creation time — if you lose it, remove the device and create a new one.
DEVICE_TOKEN=paste_your_device_token_here

# A passphrase ONLY you know. It encrypts your data before it ever leaves
# this machine — your buddy's computer only ever stores the encrypted
# result and cannot read it, and Backup Buddies' own servers never see
# this value at all. There is no "forgot passphrase" recovery: if you lose
# it, whatever's stored with your buddy is unrecoverable. Use a real
# passphrase (a few random words), not a short password.
BACKUP_PASSPHRASE=change_me_to_something_only_you_know

# Leave as-is unless you're told otherwise.
RELAY_URL=https://relay.filegarden.net

# The folder on this machine you want backed up to your buddy. Leave this
# commented out if this device is only meant to receive — it'll still
# accept and store whatever your buddy sends you, it just won't try to
# send anything of its own. Point BACKUP_DIR_HOST at the real folder (an
# absolute path, or relative to this file) and it shows up as /backup
# inside the container.
#BACKUP_DIR_HOST=./my-files

# Port on THIS machine for the local status dashboard — pledge usage,
# last backup cycle, and restore, for this device. Reachable from
# anywhere that can reach this machine on this port (your LAN, or the
# open internet if this machine is exposed to it) — it has no login of
# its own, so treat that port like you would any other unauthenticated
# admin page. See docker-compose.yml if you want it restricted to this
# machine only instead. Defaults to 8080; change it if that's taken here.
#DASHBOARD_PORT=8080

# How long (in seconds) a buddy can go without a *successful* backup/ping
# cycle before the dashboard calls them out as stale, separately from a
# single failed cycle. Defaults to 600 (10 minutes) — long enough that a
# couple of transient network blips (cycles run every 30s) don't trip it.
#STALE_AFTER_SECS=600

# Where this device's identity key and anything received from your buddy
# are stored — a real folder on this machine, not a hidden Docker volume,
# so it's easy to find, move, or point your own backup tooling at.
# Defaults to ./data, right next to this file. Change it to use a
# specific location instead — a dedicated disk, a NAS mount — with an
# absolute path or a relative one starting with ./, e.g.:
#   DATA_DIR_HOST=/mnt/backup-data
# Created automatically if it doesn't exist. Don't point two different
# devices' clients at the same directory — each needs its own.
DATA_DIR_HOST=./data
